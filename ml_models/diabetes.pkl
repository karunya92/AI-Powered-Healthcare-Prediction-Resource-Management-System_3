import joblib
from sklearn.ensemble import RandomForestClassifier
from sklearn.datasets import make_classification

X, y = make_classification(
    n_samples=1000,
    n_features=8,
    random_state=42
)

model = RandomForestClassifier()
model.fit(X, y)

joblib.dump(
    model,
    "ml_models/diabetes.pkl"
)

print("diabetes.pkl created")